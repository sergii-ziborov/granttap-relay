{
  "name": "granttap-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge WebSocket relay for GrantTap on Cloudflare Workers or a self-hosted Node server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "node src/node/server.js",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' tests/*.test.mjs",
    "check": "node --check src/worker.js && node --check src/node/server.js && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/granttap-relay.git"
  },
  "bugs": {
    "url": "https://github.com/sergii-ziborov/granttap-relay/issues"
  },
  "homepage": "https://granttap.com",
  "license": "MIT",
  "overrides": {
    "undici": "7.29.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
